meta {
  name: N023_504
  type: http
  seq: 4
}

post {
  url: {{api-host}}/{{context-path}}
  body: json
  auth: inherit
}

headers {
  Authorization: {{authorization}}
  Accept: application/vnd.hmrc.2.0+json
  correlationId: {{correlationId}}
}

body:json {
  {
    "firstName": "Raymond",
    "secondName": "Reddington",
    "dateOfBirth": "1990-06-27",
    "nino": "AA000032A",
    "bornOnOrAfter": "2023-05-01"
  }
}

tests {
  test("Should validate response based on environment behavior (406 vs 404)", function() {
    const status = res.getStatus();
    const body = res.getBody();
    const headers = res.getHeaders();
  
    if (status === 504) {
      expect(body).to.be.empty;
      const expectedCorrelationId = bru.getVar("correlationId");
      expect(headers).to.have.property("correlationid", expectedCorrelationId);
      
    } else if (status === 503) {
      console.warn("Detected Staging behavior: API returned a 404 instead of 406.");
      expect(status).to.equal(503);
      expect(body).to.be.an("object");
      expect(body).to.have.property("code", "SERVER_ERROR");
      expect(body).to.have.property("message", "Service unavailable");
  
    } else {
      fail(`Unexpected status code received: ${status}`);
    }
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
