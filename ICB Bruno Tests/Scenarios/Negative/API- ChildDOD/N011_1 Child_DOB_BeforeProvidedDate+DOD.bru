meta {
  name: N011_1 Child_DOB_BeforeProvidedDate+DOD
  type: http
  seq: 1
}

post {
  url: {{api-host}}/{{context-path}}
  body: json
  auth: inherit
}

headers {
  Authorization: {{authorization}}
  Accept: application/vnd.hmrc.2.0+json
  correlationId: {{correlationId}}
}

body:json {
  {
    "firstName": "Andrew",
    "secondName": "Harris",
    "dateOfBirth": "1990-06-27",
    "nino": "{{generatedNino}}013A",
    "bornOnOrAfter": "2023-01-01"
  }
}

assert {
  res.status: eq 200
  res.body.eligible: eq false
  res.headers.correlationid: eq {{correlationId}}
}

settings {
  encodeUrl: true
  timeout: 0
}
