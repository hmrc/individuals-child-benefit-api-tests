meta {
  name: N011_5 Children_DOB_BeforeAndAfterProvidedDate+DOD
  type: http
  seq: 3
}

post {
  url: {{api-host}}/{{context-path}}
  body: json
  auth: inherit
}

headers {
  Authorization: {{authorization}}
  Accept: application/vnd.hmrc.2.0+json
  correlationId: {{correlationId}}
}

body:json {
  {
    "firstName": "Jacob",
    "secondName": "Jackson",
    "dateOfBirth": "2000-06-01",
    "nino": "{{generatedNino}}034A",
    "bornOnOrAfter": "2026-01-01"
  }
}

assert {
  res.headers.correlationid: eq {{correlationId}}
  res.status: eq 200
  res.body.eligible: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
